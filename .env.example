# Public origin of the deployed portfolio.
# Confirmed production domain: https://djibrildione.com — set this at deploy
# time on the hosting platform (Vercel project settings, etc.), not by editing
# this file. Leave unset in local development.
# When unset, no canonical URL is emitted and metadataBase falls back to
# http://localhost:3000, and the QR code on /cv renders nothing rather than
# pointing at a placeholder.
NEXT_PUBLIC_SITE_URL=
